# Kredensial Proxmox VE diisi langsung di prometheus/pve.yml (copy dari pve.yml.example), bukan di sini.

# Grafana
GRAFANA_ADMIN_USER=admin
# Set a strong password — do not leave blank or use a default in production
GRAFANA_ADMIN_PASSWORD=

# Prometheus internal service name (used by Grafana datasource provisioning)
PROMETHEUS_URL=http://prometheus:9090
